            },
            "llmRoute": {
                "ClusterId": "llmCluster",
                "Match": {
                    "Path": "/llm/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "authCluster": {
                "Destinations": {
                    "authService": {
                        "Address": "http://authservice/"
                    }
                }
            },
            "llmCluster": {
                "Destinations": {
                    "llmService": {
                        "Address": "http://llmgatewayservice/"
                    }
                }
            }
        }
    },
